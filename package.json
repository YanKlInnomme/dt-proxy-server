{
  "name": "dt-proxy-server",
  "version": "2.0.1",
  "description": "Local proxy server for Deep Translate. Stores the DeepL API key outside Foundry and authenticates module requests with a dedicated proxy token.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg --sea .",
    "licenses": "node scripts/generate-third-party-licenses.js",
    "test": "node --test && node scripts/generate-third-party-licenses.js --check"
  },
  "keywords": [
    "deepl",
    "translation",
    "proxy",
    "foundryvtt",
    "foundry-vtt",
    "deep-translate",
    "ttrpg",
    "api-proxy"
  ],
  "author": "YanK <contact@yanklinnomme.fr> (https://yanklinnomme.fr)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "deepl-node": "^1.26.0",
    "express": "^5.2.1"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "bin": "server.js",
  "pkg": {
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YanKlInnomme/dt-proxy-server"
  },
  "bugs": {
    "url": "https://github.com/YanKlInnomme/dt-proxy-server/issues"
  },
  "homepage": "https://yanklinnomme.fr"
}
